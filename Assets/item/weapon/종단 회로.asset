  m_Script: {fileID: 11500000, guid: dba3b05a9c90412499b08118b34ae85e, type: 3}
  m_Name: "\uC885\uB2E8 \uD68C\uB85C"
  m_EditorClassIdentifier: 
  passive_description: "<size=125%><b>\u25A0\uC8FC\uAE30\uC640 \uC21C\uD658</b></size>[\uC0C1\uC2DC
    \uBC1C\uB3D9]\n    \uD655\uC2E0 \uC0C1\uD0DC\uC77C\uB54C \uBC1C\uB3D9. \uC8FC\uAE30
    \uBB38\uC591\uC774 \uB098\uD0C0\uB098\uBA70 \uCD94\uB860\uC744 \uC5BB\uC744\uB54C
    \uB300\uC2E0 12\uAC1C\uC758 \uBB38\uC591\uC744 \uCC28\uB840\uB85C \uC5BB\uC74C.
    \uC804\uBD80 \uC5BB\uB294\uB2E4\uBA74 \uD574\uB2F9 \uC8FC\uAE30\uB3D9\uC548 '\uC21C\uD658
    \uC5F0\uC0B0\uC790-\uACB0\uB2E8' \uD6A8\uACFC\uB97C \uC5BB\uACE0 \uB300\uAE30\uC2A4\uD0AC\uC5D0
    [\uB9C8\uC8FC\uD560 \uC6A9\uAE30]\uB97C \uCD94\uAC00\uD568.\n\n    \uBD80\uC815
    \uC0C1\uD0DC\uC77C\uB54C \uBC1C\uB3D9. \uC8FC\uAE30 \uBB38\uC591\uC774 \uB098\uD0C0\uB098\uBA70
    \uCD94\uB860\uC744 \uC783\uC744\uB54C \uB300\uC2E0 12\uAC1C\uC758 \uBB38\uC591\uC744
    \uCC28\uB840\uB85C \uC5BB\uC74C. \uC804\uBD80 \uC5BB\uB294\uB2E4\uBA74 \uD574\uB2F9
    \uC8FC\uAE30\uB3D9\uC548 '\uC21C\uD658 \uC5F0\uC0B0\uC790-\uC218\uB834' \uD6A8\uACFC\uB97C
    \uC5BB\uACE0 \uB300\uAE30\uC2A4\uD0AC\uC5D0 [\uB0B4\uC77C\uC758 \uB300\uAC00]\uB97C
    \uCD94\uAC00\uD568.\n\n<size=125%><b>\u25A0\uC6D0\uCD08 \uD68C\uADC0</b></size>[\uC0C1\uC2DC
    \uBC1C\uB3D9]\n    \uC21C\uD658\uC774 \uC2DC\uC791\uB420\uB54C \uCD94\uB860\uC774
    12\uBCF4\uB2E4 \uB192\uB2E4\uBA74 1\uAC10\uC18C.\n    \uC21C\uD658\uC774 \uC2DC\uC791\uB420\uB54C
    \uCD94\uB860\uC774 12\uBCF4\uB2E4 \uB0AE\uB2E4\uBA74 1\uC99D\uAC00.\n\n<size=125%><b>\u25A0\uBD80\uC815\uACFC
    \uD655\uC2E0</b></size>\n    \uC8FC\uAE30 \uC2DC\uC791 \uC2DC \uCD94\uB860\uC774
    \uC5C6\uB2E4\uBA74 \uCD94\uB860 12\uC5BB\uC74C.\n    \uD328\uB9C1\uC774\uB098
    \uBC29\uC5B4, \uD53C\uACA9\uC774 3\uBC88 \uC774\uC0C1 \uAC10\uC9C0\uB418\uBA74
    \uCD94\uB860 1 \uAC10\uC18C.\n    \uC801\uC5D0\uAC8C \uACF5\uACA9\uC774 3\uBC88
    \uC801\uC911\uD560\uB54C\uB9C8\uB2E4 \uCD94\uB860 1 \uC99D\uAC00.\n    \uCD94\uB860\uC774
    24\uC77C\uB54C '\uD655\uC2E0'\uC774 \uC5C6\uB2E4\uBA74 '\uD655\uC2E0'\uC5BB\uC74C.\n   
    \uCD94\uB860\uC774 0\uC77C\uB54C '\uBD80\uC815'\uC774 \uC5C6\uB2E4\uBA74 '\uBD80\uC815'\uC5BB\uC74C.\n\n<size=125%><b>\u25A0\uCD08\uC6D4</b></size>\n   
    '\uC21C\uD658 \uC5F0\uC0B0\uC790-\uACB0\uB2E8'\uACFC '\uC21C\uD658 \uC5F0\uC0B0\uC790-\uC218\uB834'\uC744
    \uBAA8\uB450 \uBCF4\uC720\uD558\uB294 \uC21C\uAC04 \uBC1C\uB3D9. \uB300\uAE30\uC2A4\uD0AC\uC5D0
    [\uC774\uC911 \uACB0\uB2E8]\uC744 \uCD94\uAC00\uD568.\n    \uBC1C\uB3D9 \uC2DC
    \uD655\uC2E0\uACFC \uBD80\uC815 \uC911 \uCD5C\uADFC\uC5D0 \uC5BB\uC740 \uD6A8\uACFC\uAC00
    \uD655\uC2E0\uC774\uBA74 '\uC885\uB2E8'\uC5BB\uC74C.\n    \uBC1C\uB3D9 \uC2DC
    \uD655\uC2E0\uACFC \uBD80\uC815 \uC911 \uCD5C\uADFC\uC5D0 \uC5BB\uC740 \uD6A8\uACFC\uAC00
    \uBD80\uC815\uC774\uBA74 '\uC21C\uD658'\uC5BB\uC74C.\n\n<size=125%><b>\u25A0\uB098\uC544\uAC08
    \uC758\uC9C0</b></size>\n     {\uCD94\uB860\xD72}%\uB9CC\uD07C \uD53C\uD574\uB7C9,
    \uADE0\uD615 \uD53C\uD574 \uC99D\uAC00.\n\n<size=125%><b>\u25A0\uC9C0\uCF1C\uB0BC
    \uACB0\uC758</b></size>\n     {(24-\uCD94\uB860)\xD72}%\uB9CC\uD07C \uBC29\uC5B4\uB825
    \uC99D\uAC00. \uC21C\uD658 \uC2DC\uC791 \uC2DC \uADE0\uD615 \uCD5C\uB300\uCE58\uC758
    {(24-\uCD94\uB860)\xD72}%\uB9CC\uD07C \uD761\uC218 \uC5BB\uC74C."
