  passive_description: "<size=125%><b>\u25A0\uBE57\uC0B4</b></size>\n\uD2B9\uC815
    \uC2A4\uD0AC\uC744 \uC0AC\uC6A9\uD560\uB54C, \uACBD\uB85C\uC5D0 \uC2A4\uD0AC[\uBE57\uC0B4]\uC744
    \uC0AC\uC6A9\uD568.\n\uC0C1\uB300\uC758 '\uC8FC\uC2DC\uC728'\uC774 50 \uC774\uC0C1\uC774\uB77C\uBA74
    \uC21C\uD658\uC774 \uC2DC\uC791\uD560\uB54C \uB9C8\uB2E4 [\uBE57\uC0B4]\uC744
    \uC0AC\uC6A9\uD568.\n\n<size=125%><b>\u25A0\uAE09\uC18D\uBCC0\uD615</b></size>\n\uC774
    \uBB34\uAE30\uC758 [\uAD00\uD1B5-\uC0AC\uACA9]\uC2A4\uD0AC\uC740 \uC0AC\uC6A9\uD560\uB54C,
    \uD574\uB2F9 \uC21C\uD658\uC5D0 [\uD2B9\uC218-\uD589\uB3D9(\uBCC0\uD615)]\uC744
    \uBA3C\uC800 \uC0AC\uC6A9\uD558\uC9C0 \uC54A\uC558\uB2E4\uBA74, \uD574\uB2F9
    \uC8FC\uAE30\uB3D9\uC548 [\uAD00\uD1B5-\uC0AC\uACA9]\uC758 \uC704\uB825\uC774
    0.4\uC529 \uB0AE\uC544\uC9D0. \uB9CC\uC57D \uD0C4\uD658\uC774 \uC5C6\uB2E4\uBA74,
    \uBCC0\uD615\uC758 \uC5EC\uBD80\uC5D0 \uC0C1\uAD00\uC5C6\uC774 0.8\uC529 \uB0AE\uC544\uC9D0.\n\n<size=125%><b>\u25A0\uD655\uB960\uB860</b></size>\n\uC804\uD22C
    \uC2DC\uC791\uC2DC \uC0C1\uB300\uC5D0\uAC8C '\uC8FC\uC2DC\uC728' \uBD80\uC5EC.\n\uC0C1\uB300\uC758
    \uAC70\uB9AC\uC5D0 \uBC18\uBE44\uB840\uD574 '\uC8FC\uC2DC\uC728'\uC774 1 ~ 99\uAE4C\uC9C0
    \uBCC0\uB3D9\uD568.\n\uADE0\uD615\uBD95\uAD34 \uC0C1\uD0DC\uC5D0 \uC9C4\uC785\uD560\uB54C,
    \uC8FC\uC2DC\uC728\uC774 \uBCC0\uB3D9\uD558\uC9C0 \uC54A\uC74C.\n\n<size=125%><b>\u25A0\uBE57\uC0B4</b></size>[\uC989\uC2DC
    \uBC1C\uB3D9]\n[\uC801\uC911 \uC2DC 3\uCD08\uAC04 \uAD00\uD1B5 \uC0C1\uC131 0.1\uC99D\uAC00,
    3\uCD08\uAC04 '\uC8FC\uC2DC\uC728' 10 \uAC10\uC18C]\n[\uAD00\uD1B5 1.2]"
  normalskill_description: "<size=125%><b>\u25A0[\uCC38\uACA9-\uC885]</b></size>\n[\uCC38\uACA9
    2.1]\n\n<size=125%><b>\u25A0[\uCC38\uACA9-\uD6A1]</b></size>\n[\uCC38\uACA9 1.4]\n\n<size=125%><b>\u25A0[\uCC38\uACA9-\uC0AC\uC120]</b></size>\n[\uCC38\uACA9
