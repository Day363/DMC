  dialogues:
  - dialoguename: filer_dialogue
    playervoice: player_chat
    enemyvoice: trapal_chat
    dialogueLines:
    - target: 1
      objectname: 
      dialogue: "...\uC74C?"
      basicdelay: 0.05
      dotdelay: 0.25
      cantskip: 0
      end: 0
      end_lookplayer: 1
      end_letterboxin: 1
      gotoanswer: 0
      answerindex: 0
    - target: 1
      objectname: 
      dialogue: "\uC8C4\uC1A1\uD55C\uB370, \uB204\uAD6C\uC2DC\uC8E0?"
      basicdelay: 0.05
      dotdelay: 0.25
      cantskip: 0
      end: 0
      end_lookplayer: 1
      end_letterboxin: 1
      gotoanswer: 0
      answerindex: 0
    - target: 0
      objectname: 
      dialogue: "...\uC0C1\uB2F4\uC0AC"
      basicdelay: 0.05
      dotdelay: 0.25
      cantskip: 0
      end: 0
      end_lookplayer: 1
      end_letterboxin: 1
      gotoanswer: 0
      answerindex: 0
    - target: 1
      objectname: 
      dialogue: "\uC0C1\uB2F4\uC0AC\uB77C...\uC798\uC740 \uBAA8\uB974\uACA0\uC9C0\uB9CC...
        \uAF64 \uB192\uC740 \uC218\uC900\uC758 \uC758\uC2DD\uC744 \n\uC720\uC9C0\uD558\uACE0
        \uACC4\uC2DC\uB294 \uAC83 \uAC19\uAD70\uC694."
      basicdelay: 0.05
      dotdelay: 0.25
      cantskip: 0
      end: 0
      end_lookplayer: 1
      end_letterboxin: 1
      gotoanswer: 0
      answerindex: 0
    - target: 1
      objectname: 
      dialogue: "\uBB50.. \uBC29\uD574\uB9CC \uC548 \uB41C\uB2E4\uBA74\uC57C \uBC1C\uC774
        \uAC00\uB294 \uB370\uB85C \uB9C8\uC74C\uAECF \uB3CC\uC544\uB2E4\uB2C8\uC154\uB3C4
        \uB429\uB2C8\uB2E4."
      basicdelay: 0.05
      dotdelay: 0.25
      cantskip: 0
      end: 0
      end_lookplayer: 1
      end_letterboxin: 1
      gotoanswer: 0
      answerindex: 0
    - target: 1
      objectname: 
      dialogue: "...\uADF8\uAC74 \uADF8\uB807\uACE0, \uACE7 \uC0C8\uB85C\uC6B4 \uC8FC\uAE30\uAC00
        \uC2DC\uC791\uB420 \uAC83 \uAC19\uB124\uC694."
      basicdelay: 0.05
      dotdelay: 0.25
      cantskip: 0
      end: 0
      end_lookplayer: 1
      end_letterboxin: 1
      gotoanswer: 0
      answerindex: 0
    - target: 1
      objectname: 
      dialogue: "\uC5B4\uB5BB\uC2B5\uB2C8\uAE4C? \uC0C8 \uC8FC\uAE30\uB97C \uB9DE\uC774\uD558\uBA70
        \uC790\uC544\uAC00 \uC0AC\uB77D\uC0AC\uB77D \uC800\uBA70\uC838 \uAC00\uB294
        \uAE30\uBD84\uC740. "
      basicdelay: 0.05
      dotdelay: 0.25
      cantskip: 0
      end: 0
      end_lookplayer: 1
      end_letterboxin: 1
      gotoanswer: 0
      answerindex: 0
    - target: 0
      objectname: 
      dialogue: "\uC0C8\uB85C\uC6B4 \uC8FC\uAE30?"
      basicdelay: 0.05
      dotdelay: 0.25
      cantskip: 0
      end: 0
      end_lookplayer: 1
      end_letterboxin: 1
      gotoanswer: 0
      answerindex: 0
    - target: 1
      objectname: 
      dialogue: "\uB2F9\uC2E0\uC740 \uAE30\uC5B5\uB098\uC9C0 \uC54A\uACA0\uC9C0\uB9CC,
        \uC544\uB9C8 \uC218\uB3C4 \uC5C6\uC774 \uB9CE\uC740 \uC8FC\uAE30\uB97C \uBC18\uBCF5\uD588\uACA0\uC8E0."
      basicdelay: 0.05
      dotdelay: 0.25
      cantskip: 0
      end: 0
      end_lookplayer: 1
      end_letterboxin: 1
      gotoanswer: 0
      answerindex: 0
    - target: 1
      objectname: 
      dialogue: "\uC800\uB3C4 \uB2F9\uC2E0\uC774 \uC5EC\uAE30 \uC628 \uAE30\uC5B5\uC740
        \uC0C8\uAE30\uACE0 \uC788\uC9C0 \uC54A\uC9C0\uB9CC... \uC544\uB9C8 \n\uD56D\uC0C1
        \uB611\uAC19\uC774 \uC5EC\uAE38 \uCC3E\uC544\uC624\uACE0, \uAC19\uC740 \uB300\uD654\uB97C
        \uBC18\uBCF5\uD588\uC744 \uAC81\uB2C8\uB2E4."
      basicdelay: 0.05
      dotdelay: 0.25
      cantskip: 0
      end: 0
      end_lookplayer: 1
      end_letterboxin: 1
      gotoanswer: 0
      answerindex: 0
    - target: 0
      objectname: 
      dialogue: "\uC0C8\uAE34\uB2E4\uACE0?"
      basicdelay: 0.05
      dotdelay: 0.25
      cantskip: 0
      end: 0
      end_lookplayer: 1
      end_letterboxin: 1
      gotoanswer: 0
      answerindex: 0
    - target: 1
      objectname: 
      dialogue: "\uC5D0\uCE6D\uC73C\uB85C \uAE30\uC5B5\uC744 \uC9C1\uC811 \uB1CC\uC5D0
        \uC0C8\uAE30\uC8E0. \uD658\uC6D0\uC18D\uC5D0\uC11C \uC720\uC77C\uD558\uAC8C\uB098\uB9C8
        \n\uB2E4\uC74C \uC8FC\uAE30\uB85C \uAC00\uC838\uAC08 \uC218 \uC788\uB294\uAC83\uB4E4\uC785\uB2C8\uB2E4."
      basicdelay: 0.05
      dotdelay: 0.25
      cantskip: 0
      end: 0
      end_lookplayer: 1
      end_letterboxin: 1
      gotoanswer: 0
      answerindex: 0
    - target: 1
      objectname: 
      dialogue: "\uC0C8\uAE38 \uC218 \uC788\uB294 \uCD1D\uB7C9\uC740 \uADF8\uB9AC
        \uD06C\uC9C0 \uC54A\uC9C0\uB9CC... \uAE30\uC5B5\uC744 \uC758\uC874\uD560
        \uC218 \uC788\uB2E4\uBA74.."
      basicdelay: 0.05
      dotdelay: 0.25
      cantskip: 0
      end: 0
      end_lookplayer: 1
      end_letterboxin: 1
      gotoanswer: 0
      answerindex: 0
    - target: 1
      objectname: 
      dialogue: "\uC774\uB807\uAC8C \uC0DD\uAC01\uD558\uB2C8 \uC800\uB294 \uC544\uBB34\uAC83\uB3C4
        \uC544\uB2CC\uAC83\uAC19\uB124\uC694."
      basicdelay: 0.05
      dotdelay: 0.25
      cantskip: 0
      end: 0
      end_lookplayer: 1
      end_letterboxin: 1
      gotoanswer: 0
      answerindex: 0
    - target: 1
      objectname: 
      dialogue: "\uC9C0\uAE08 \uC774\uB807\uAC8C \uBA40\uCA61\uD55C\uAC83\uCC98\uB7FC
        \uBCF4\uC5EC\uB3C4, \uACB0\uAD6D \uC81C \uB1CC\uC5D0 \uC0C8\uACA8\uC9C4 \n\uC5D0\uCE6D\uC774
        \uC81C \uC815\uCCB4\uC131\uC744 \uD615\uC131\uD558\uACE0\uC788\uB2E4\uB294
        \uC0AC\uC2E4\uC774..."
      basicdelay: 0.05
      dotdelay: 0.25
      cantskip: 0
      end: 0
      end_lookplayer: 1
      end_letterboxin: 1
      gotoanswer: 0
      answerindex: 0
    - target: 1
      objectname: 
      dialogue: "\uC774\uBBF8 \uD658\uC6D0\uC18D\uC5D0 \uC0BC\uCF1C\uC9C4 \uC9C4\uC9DC
        \uC800\uB294 \uC0C8\uACA8\uC9C4 \uC5D0\uCE6D\uC5D0 \uB530\uB77C \n\uBC18\uBCF5\uC791\uC5C5\uB9CC\uC744
        \uD558\uB294 \uAECD\uB370\uAE30\uCC98\uB7FC \uB290\uAEF4\uC9C0\uB294\uAD70\uC694...."
      basicdelay: 0.05
      dotdelay: 0.25
      cantskip: 0
      end: 0
      end_lookplayer: 1
      end_letterboxin: 1
      gotoanswer: 0
      answerindex: 0
    - target: 1
      objectname: 
      dialogue: "\uADF8\uAC74 \uADF8\uB807\uACE0, \uC2DC\uAC04\uC774 \uC5BC\uB9C8
        \uB0A8\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
      basicdelay: 0.05
      dotdelay: 0.25
      cantskip: 0
      end: 0
      end_lookplayer: 1
      end_letterboxin: 1
      gotoanswer: 0
      answerindex: 0
    - target: 1
      objectname: 
      dialogue: "\uC800\uB294 \uC0C1\uB2F4\uC0AC...\uB2D8\uC774 \uB204\uAD70\uC9C0\uB294
        \uC54C \uC218 \uC5C6\uACA0\uC9C0\uB9CC, \uBD80\uB514 \uB0A8\uC740 \uC2DC\uAC04\uC744
        \uB354 \uC758\uBBF8\uC788\uAC8C \uC4F0\uC138\uC694"
      basicdelay: 0.05
      dotdelay: 0.25
      cantskip: 0
      end: 0
      end_lookplayer: 1
      end_letterboxin: 1
      gotoanswer: 0
      answerindex: 0
    - target: 1
      objectname: 
      dialogue: "\uC800\uB294 \uC774 \uC790\uB9AC\uC5D0\uC11C \uBAA8\uB450\uB97C
        \uC704\uD55C \uD574\uACB0\uCC45\uC744 \uCC3E\uC744\uD14C\uB2C8... \uADF8\uB7EC\uB2C8,
        \n\uB0B4\uC77C\uC758 \uD574\uB97C \uB9DE\uC774\uD558\uAE30 \uC704\uD55C \uC900\uBE44\uB97C
        \uD574\uB450\uC138\uC694."
      basicdelay: 0.05
      dotdelay: 0.25
      cantskip: 0
      end: 0
      end_lookplayer: 1
      end_letterboxin: 1
      gotoanswer: 0
      answerindex: 0
    - target: 1
      objectname: 
      dialogue: "\uC544\uB9C8 \uB2F9\uC2E0\uC758 \uB0B4\uC77C\uC740 \uD55C \uC8FC\uAE30\uAC00
        \uBC18\uBCF5\uB418\uAE30\uB3C4 \uC804\uC5D0 \uCC3E\uC544\uC62C\uAC81\uB2C8\uB2E4."
      basicdelay: 0.05
      dotdelay: 0.25
      cantskip: 0
      end: 0
      end_lookplayer: 1
      end_letterboxin: 1
      gotoanswer: 0
      answerindex: 0
    - target: 1
      objectname: 
      dialogue: "\uAE30\uC5B5\uC740... <shake=0.3,15>\uBABB\uD558\uACA0\uC9C0\uB9CC.</shake>"
