  itemtag_: 0
  itemName: "\uAE30\uC5B5\uD558\uB9AC\uB77C"
  itemImage: {fileID: 21300000, guid: a4ee697a1fb961543815cdc1a767ee93, type: 3}
  usable: 0
  itemdescription: "\uACF5\uB3D9(\u5B54\u6D1E)\uBB18\uC9C0\uC5D0\uC11C \uBC1C\uACAC\uB41C
    \uBA54\uBAA8."
  stroydescription: "\uC774 \uB545\uC5D0 \uB51B\uC740 \uCCAB \uBC1C\uC790\uAD6D\uACFC
    \uB9C8\uC9C0\uB9C9 \uB0A0\uC228 \uC0AC\uC774,\r\n\uBC1C \uB51B\uC74C\uACFC \uAE30\uC5B5\uACFC
    \uC678\uCE68\uACFC, \uC6A9\uAE30.\r\n\uADF8 \uAE30\uC138\uB97C \uC5B4\uB9AC\uC11D\uB2E4\uACE0
    \uB9D0\uD558\uC9C0 \uBABB\uD55C \uC6B0\uB9AC\uB97C \uD0D3\uD574\uB2E4\uC624.\r\n\r\n\uC774
    \uD759\uC744 \uD37C\uC62C\uB9B0 \uCCAB \uC0BD\uACFC, \uADF8 \uD759\uC5D0 \uC2EC\uC740
    \uB098\uBB34\uC758 \uBFCC\uB9AC.\r\n\uADF8 \uC0AC\uC774\uC5D0 \uB108\uD774 \uBB3B\uC744
    \uC218 \uBC16\uC5D0 \uC5C6\uB294 \uC6B0\uB9AC\uB97C \uC6A9\uC11C\uD574\uB2E4\uC624.\r\n\r\n\uBBF8\uC548\uD558\uB2E4\uACE0
    \uBC16\uC5D0 \uB9D0\uD558\uC9C0 \uBABB\uD558\uB294, \uAE30\uC5B5\uD558\uB9AC\uB77C\uACE0
    \uBC16\uC5D0 \uB9D0\uD558\uC9C0 \uBABB\uD558\uB294, \uC774\uBBF8 \uC8FD\uC740
    \uD3B8\uC9C0\uB97C \uC774 \uACF5\uB3D9\uC5D0 \uBB3B\uC73C\uB9C8.\r\n\r\n\uBBF8\uC548\uD558\uB2E4."
