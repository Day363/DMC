  textlist:
  - text:
    - "\"\uBC18\uAC11\uC2B5\uB2C8\uB2E4.\""
    - "\"\uC5EC\uC804\uD788 \uBE44\uAC00 \uB0B4\uB9AC\uB294 \uBD88\uCF8C\uD55C 30\uAD6C\uC758
      \uC544\uCE68\uC785\uB2C8\uB2E4.\""
    - "\"\uC624\uB298\uB3C4 \uCE59\uCE59\uD55C \uB0B4\uC77C\uC744 \uAE30\uB300\uD558\uB294
      30\uAD6C\uC758 \uC2DC\uBBFC...\""
    - "\"...\uC774 \uC544\uB2C8\uAD70\uC694.\""
    - "\uD2B9\uC774\uD55C \uCC28\uB9BC\uC744 \uD55C \uC0C1\uB2F4\uC790\uB2E4."
    - "\uB2F9\uCD5C \uBB34\uC2A8\uB9D0\uC744 \uD558\uB294\uAC74\uC9C0..."
    - "\"\uC6B4\uBA85\uB860\uC801 \uD655\uB960\uACC4\uC0B0\uC790\uB97C \uC544\uC2ED\uB2C8\uAE4C?\""
