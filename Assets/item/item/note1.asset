  itemtag_: 0
  itemName: "\uC5EC\uB85C\uB97C \uD5A5\uD574"
  itemImage: {fileID: 21300000, guid: a4ee697a1fb961543815cdc1a767ee93, type: 3}
  usable: 0
  itemdescription: "\uC81C\uAD6D \uC678\uACFD\uC5D0\uC11C \uBC1C\uACAC\uB41C \uBA54\uBAA8."
  stroydescription: "\uC6B0\uB9AC\uB294 \uD5C8\uB7C9\uC73C\uB85C \uAC04\uB2E4.\n\uB05D\uC5C6\uC774
    \uB298\uC5B4\uC120 \uBE0C\uB9BF\uC9C0\uB97C \uB530\uB77C, \uC800 \uBA3C \uC9C0\uD3C9\uC120
    \uB108\uBA38\uB85C\n\uC81C\uAD6D\uC5D0 \uBC14\uCCD0\uC9C4 \uB3D9\uD3EC\uB4E4\uC758
    \uC2DC\uC2E0\uC744 \uB118\uC5B4, \uBBF8\uC9C0\uB97C \uD5A5\uD574 \uB098\uC544\uAC04\uB2E4.\n\n\uC544\uB9C8
    \uC774 \uBE44\uC11D\uC744 \uBC1C\uACAC\uD588\uB2E4\uBA74 \uC6B0\uB9AC\uC640 \uAC19\uC740
    \uAE38\uC744 \uAC78\uC5B4\uC624\uACE0 \uC788\uC744 \uD14C\uC9C0. \n\uADF8\uB7EC\uB098
    \uBA48\uCD94\uC5B4\uB77C.\n\uC774 \uAE38\uC740 \uC6B0\uB9AC\uB9CC\uC758 \uAE38,
    \uC6B0\uB9AC\uC758 \uC5EC\uB85C.\n\uC5B4\uB9AC\uC11D\uC740 \uC790\uB4E4\uC774
    \uBAA8\uC5EC, \uB450\uB824\uC6C0\uC744 \uBB3B\uC5B4\uB450\uACE0,\n\uAC00\uC7A5
    \uBA3C \uACF3\uC5D0\uC11C \uC8FD\uC74C\uC744 \uB9DE\uC774\uD558\uAE30 \uC704\uD574
    \uB5A0\uB098\uB294 \uAE38.\n\n\uADF8\uB7EC\uB2C8 \uBA48\uCD94\uC5B4\uB77C. \uC81C\uAD6D\uC5D0\uC11C\uB294
    \uADF8\uB300\uB97C \uD5C8\uB7C9\uC73C\uB85C \uB5A0\uBC00\uC9C0 \uC54A\uC744 \uD14C\uB2C8.\n\uADF8\uB798\uB3C4
    \uB098\uC544\uAC08 \uC758\uC9C0\uAC00 \uC788\uB2E4\uBA74,\n\uB098\uC544\uAC00\uACE0\uC790
    \uD55C\uB2E4\uBA74,\n\uB098\uC544\uAC00\uC57C\uB9CC \uD55C\uB2E4\uBA74,\n\uBE44\uC11D\uC744
    \uBD80\uC234\uB77C.\n\uBE44\uC11D\uC744 \uBD80\uC218\uACE0 \uB098\uC544\uAC00\uB77C.\n\n\uC5EC\uB85C\uC758
    \uB05D\uC5D0\uC11C \uAE30\uB2E4\uB9AC\uACA0\uB2E4.\n\uC774\uC81C\uB294 \uC6B0\uB9AC\uC758
    \uAC83\uC774 \uB41C \uC5EC\uB85C\uC758 \uB05D\uC5D0\uC11C."
